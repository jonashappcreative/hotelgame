# Frontend environment configuration
# Copy this file to .env.local and fill in your actual values.

# Socket.IO endpoint the browser connects to for realtime room events.
# The backend serves this on the same origin as the API.
# Local dev: the Hono backend. Production: the public site.
VITE_WS_URL=http://localhost:3000
# VITE_WS_URL=wss://hotelgame.jonashapp.com

# ---------------------------------------------------------------------------
# Backend secrets below are NOT used by the frontend build. They live in
# ~/aquire02/.env on the Hetzner host (and in Coolify's environment), never in
# this repo. See docs/infrastructure/ARCHITECTURE.md.
#
#   POSTGRES_PASSWORD     Password for the postgres container
#   DATABASE_URL          Postgres connection string (built from the above)
#   JWT_SECRET            Sign/verify auth tokens
#   ALLOWED_ORIGINS       Allowed browser origins (CORS + Socket.IO), comma-separated
#   DEBUG_ERRORS          Set to 1 to surface error causes in responses while debugging
# ---------------------------------------------------------------------------
